version: '3.8'

services:
  nginx: 
    ports:
      - "80:80"
    volumes:
      - ../../../apps/api/storage/app/public:/var/www/api/storage/app/public: ro

  api:
    build: 
      target: development
    environment:
      - APP_ENV=local
      - APP_DEBUG=true
    volumes:
      - ../../../apps/api:/var/www/html
      - /var/www/html/vendor
    ports:
      - "8000:8000"

  web:
    build: 
      target: development
    environment: 
      - NODE_ENV=development
    volumes:
      - ../../../apps/web:/app
      - /app/node_modules
      - /app/.next
    ports:
      - "3000:3000"

  postgres:
    ports:
      - "5432:5432"

  redis:
    ports: 
      - "6379:6379"

  horizon:
    volumes:
      - ../../../apps/api:/var/www/html
      - /var/www/html/vendor

  scheduler:
    volumes:
      - ../../../apps/api:/var/www/html
      - /var/www/html/vendor